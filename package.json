{
  "name": "politic-spectrum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=12.0.2"
  },
  "scripts": {
    "dev": "vite",
    "test": "npm run test:content && npm run test:unit",
    "test:content": "node scripts/test-polarity.mjs && node scripts/test-bibliography.mjs && node scripts/test-research.mjs && node scripts/test-validation.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "validate:content": "node scripts/validate-content.mjs",
    "build": "npm run validate:content && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
